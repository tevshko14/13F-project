# ── Required: None! The app runs without any env vars. ──
# Copy this file to .env and uncomment the vars you need:
#   cp .env.example .env

# ── Supabase (persistent cache + auth) ──
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=eyJ...
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_JWT_SECRET=your-jwt-secret

# ── Clerk (primary auth provider) ──
# CLERK_DOMAIN=your-app.clerk.accounts.dev
# CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_WEBHOOK_SECRET=whsec_...

# ── External APIs (all optional, graceful fallback without them) ──
# FINNHUB_API_KEY=your-key          # Analyst ratings + news sentiment
# ALPHAVANTAGE_API_KEY=your-key     # NLP news sentiment (25/day free)
# YOUTUBE_API_KEY=your-key          # YouTube calendar sync
# GLASSDOOR_RAPIDAPI_KEY=your-key   # Employee culture data
# PDL_API_KEY=your-key              # Employee headcount

# ── Server settings ──
# PORT=8000
# HOST=127.0.0.1
# LOG_LEVEL=DEBUG
